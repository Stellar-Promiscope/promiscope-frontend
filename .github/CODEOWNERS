# CODEOWNERS — Promiscope Frontend
#
# When a PR touches files under a listed path, GitHub automatically
# requests a review from the matching owner(s). The last matching rule
# for a given file wins.
#
# Owners can be individual @-handles or GitHub teams.
# Teams are preferred for shared areas (e.g. @promiscope/core).
#
# To validate: push to a branch and GitHub's UI will flag any syntax
# errors (typo'd usernames, invalid team names, bad patterns).

# ── Root configuration & CI ──────────────────────────────────────────────────
/.github/         @promiscope/maintainers
/package.json     @promiscope/maintainers
/tsconfig.json    @promiscope/maintainers

# ── Security-sensitive auth routes ───────────────────────────────────────────
/app/api/auth/    @promiscope/maintainers

# ── CSP & security ───────────────────────────────────────────────────────────
/app/api/csp-report/  @promiscope/maintainers

# ── Smart contract interaction layer ─────────────────────────────────────────
/lib/contract.ts      @promiscope/maintainers
/lib/stellar.ts       @promiscope/maintainers
/lib/contractErrorMessage.ts  @promiscope/maintainers

# ── Indexer package ──────────────────────────────────────────────────────────
/packages/indexer/    @promiscope/maintainers

# ── Server / backend API ─────────────────────────────────────────────────────
/server/              @promiscope/maintainers

# ── i18n messages (translations must be reviewed by bilingual contributors) ──
/messages/            @promiscope/maintainers

# ── Admin components & fraud detection ───────────────────────────────────────
/components/admin/    @promiscope/maintainers
/lib/fraudDetection.ts  @promiscope/maintainers
/lib/adminAuth.ts      @promiscope/maintainers

# ── Wallet & auth context ────────────────────────────────────────────────────
/context/            @promiscope/maintainers
/hooks/useWallet.ts   @promiscope/maintainers
/hooks/useRequireWallet.ts  @promiscope/maintainers

# ── SEP-10 auth flow (Stellar-specific, high-security) ───────────────────────
/lib/walletAdapters.ts  @promiscope/maintainers

# ── Documentation ────────────────────────────────────────────────────────────
/docs/               @promiscope/maintainers
/DEVELOPMENT.md      @promiscope/maintainers
