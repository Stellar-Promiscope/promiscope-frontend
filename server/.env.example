# Port the backend HTTP server listens on.
PORT=4000

# Comma-separated origins allowed to make cross-origin requests.
# CORS_ORIGIN (a single origin) is still honored for backward compatibility.
CORS_ORIGINS=http://localhost:3000

# Legacy single allowed origin; prefer CORS_ORIGINS.
CORS_ORIGIN=

# Optional regex for extra allowed origins, e.g. Vercel preview deployments:
# ^https://promiscope-[a-z0-9-]+\.vercel\.app$
CORS_ORIGIN_PATTERN=

# Number of reverse proxies in front of the server (so req.ip is the client).
TRUST_PROXY_HOPS=0

# Max JSON request body size; larger bodies get a 413.
JSON_BODY_LIMIT=100kb

# Per-IP rate limits: all requests, write methods, and Turnstile routes.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_TURNSTILE_MAX=10

# When set, rate-limit counters are shared through Redis.
REDIS_URL=

# How long (ms) a client may take to send a complete request.
REQUEST_TIMEOUT_MS=30000

# Path to the SQLite database file. Defaults to ./data/promiscope.db
# (relative to server/) when unset.
DB_PATH=./data/promiscope.db

# Cloudflare Turnstile secret key, used to verify the challenge token
# submitted with POST /referrals/generate. Leave blank to skip verification
# (local dev / tests).
TURNSTILE_SECRET_KEY=
