# ─────────────────────────────────────────────────────────────────────────────
# ScoutOff — Environment Variable Template
# Copy this file: cp .env.example .env.local  (never commit .env.local)
# ─────────────────────────────────────────────────────────────────────────────

# ── Stellar / Soroban ─────────────────────────────────────────────────────────

# Deployed ScoutOff Soroban contract address on Testnet or Mainnet.
# Obtain after running: stellar contract deploy --wasm ... --network testnet
NEXT_PUBLIC_CONTRACT_ID=

# Stellar network to target. Use 'testnet' for development, 'mainnet' for production.
NEXT_PUBLIC_NETWORK=testnet

# Stellar Horizon REST API endpoint. Used for account queries and transaction submission.
# Testnet default: https://horizon-testnet.stellar.org
# Mainnet:        https://horizon.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint for smart-contract reads and simulations.
# Testnet default: https://soroban-testnet.stellar.org
# Mainnet:        https://soroban-rpc.stellar.org
NEXT_PUBLIC_SOROBAN_RPC=https://soroban-testnet.stellar.org

# ── IPFS / Pinata ─────────────────────────────────────────────────────────────

# Pinata API key for IPFS uploads via the server-side proxy (app/api/ipfs/upload).
# Obtain from: https://app.pinata.cloud/keys — create a key with pinFileToIPFS scope.
# Server-side only — never expose to the client or commit to version control.
PINATA_API_KEY=

# Pinata API secret paired with PINATA_API_KEY.
# Server-side only — never expose to the client or commit to version control.
PINATA_SECRET=

# Public IPFS gateway used to serve stored media (player photos, highlight reels).
# Default: https://gateway.pinata.cloud/ipfs
# Any IPFS-compatible gateway works (e.g. https://ipfs.io/ipfs or a custom one).
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# In-memory TTL (milliseconds) for cached pinned-JSON reads in lib/pinJson.ts.
# Leave blank to use the built-in default. Must be a positive integer if set.
PINJSON_CACHE_TTL_MS=

# ── Shared Upstash Redis (lib/rateLimit.ts, lib/chunkedUploadStore.ts) ────────
#
# Used by app/api/players/search and app/api/ipfs/upload to throttle requests
# per client IP, and by the chunked-upload session store (issue #1175) to
# track which chunks a session has received. REQUIRED in production for both
# to be globally authoritative across serverless instances (e.g. Vercel).
# Without a shared store, each instance tracks its own counter/session state,
# so the rate limiter's effective limit becomes roughly limit × N (where
# N = warm instance count), and a resumed chunked upload can fail with
# "session not found" if it lands on a different instance than the one that
# received earlier chunks.
#
# Local dev/tests: leave these blank. Both stores automatically fall back to
# an in-memory per-instance store, which is fully sufficient for a single
# local process — no Upstash account needed to develop or run tests.
# Obtain from: https://console.upstash.com — create a Redis database.

# Full REST URL of your Upstash Redis database (e.g. https://<db>.upstash.io).
UPSTASH_REDIS_REST_URL=

# Bearer token for the Upstash Redis REST API.
# Server-side only — never expose to the client or commit to version control.
UPSTASH_REDIS_REST_TOKEN=

# ── Signed CV exports ─────────────────────────────────────────────────────────

# PKCS#8 Ed25519 private key used by /api/cv/sign to sign CV snapshots.
# Keep this secret in the deployment environment. Generate a key pair with:
#   openssl genpkey -algorithm Ed25519 -out cv-signing-private.pem
#   openssl pkey -in cv-signing-private.pem -pubout -out cv-signing-public.pem
CV_SIGNING_SECRET=

# Optional PKCS#8 Ed25519 public key used by the public verification page.
# When blank, the public key is derived from CV_SIGNING_SECRET server-side.
CV_SIGNING_PUBLIC_KEY=

# ── Media Proxy Signed-URL Secret ─────────────────────────────────────────────

# Optional secret used by /api/media/[cid] to issue signed, time-limited URLs
# (lib/mediaUrlSigning.ts). When set, every media URL is HMAC-signed and
# expires after a configurable window. Leave blank locally — the proxy falls
# back to referrer-only gating when this is unset.
# Generate with: openssl rand -hex 32
# Server-side only — never expose to the client or commit to version control.
MEDIA_URL_SIGNING_SECRET=

# ── Backend API ───────────────────────────────────────────────────────────────

# Optional server-side webhook URL used to notify the backend about
# reconciliation events.
RECONCILIATION_WEBHOOK_URL=

# Base URL of the off-chain Node.js backend API (server/).
# Default for local development: http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-only override for SSR / Server Component fetches (e.g. Docker Compose
# container-internal hostname: http://mock-api:4000). Leave blank outside of
# docker-compose — lib/api.ts falls back to NEXT_PUBLIC_API_URL when unset.
API_URL_INTERNAL=

# ── Cloudflare Turnstile ──────────────────────────────────────────────────────

# Public site key for the Cloudflare Turnstile bot-protection widget shown on
# unauthenticated public forms (e.g. referral code generation). Leave blank to
# disable the challenge locally — the server-side check is skipped when its
# corresponding secret is unset (see server/.env.example).
# Obtain from: https://dash.cloudflare.com — Turnstile → Add widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Indexer Query API (packages/indexer) ─────────────────────────────────────

# Server-only base URL of the off-chain event indexer API. The browser never
# calls the indexer directly: it goes through the same-origin, rate-limited
# proxy at /api/indexer/*, which forwards to this URL, so the indexer can stay
# on a private network. Default for local development: http://localhost:3001
INDEXER_API_URL_INTERNAL=http://localhost:3001

# Deprecated: used only as a fallback when INDEXER_API_URL_INTERNAL is unset.
NEXT_PUBLIC_INDEXER_API_URL=

# Optional Next.js bundle analysis switch. Set to 'true' when running the
# configured bundle analyzer.
ANALYZE=

# ── Indexer Worker (packages/indexer) ─────────────────────────────────────────
#
# Only read by the standalone indexer worker process (packages/indexer/src/
# eventPoller.ts, eventStore.ts) — not by the Next.js app itself. Set these
# when running the indexer directly (npm run --workspace=packages/indexer).

# Soroban RPC endpoint the indexer polls for contract events. Required.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployed ScoutOff Soroban contract address the indexer watches. Required.
CONTRACT_ID=

# Network passphrase for the target Stellar network.
# Testnet default: 'Test SDF Network ; September 2015'
# Mainnet:        'Public Global Stellar Network ; September 2015'
NETWORK_PASSPHRASE=

# How often (milliseconds) the indexer polls for new events. Leave blank to
# use the built-in default.
POLL_INTERVAL_MS=

# Ledger sequence to start polling from on first run. Leave blank to start
# from the most recent ledger.
START_LEDGER=

# Filesystem path to the indexer's SQLite database file. Leave blank to use
# the built-in default location.
INDEXER_DB_PATH=

# ── Auth (SEP-10) ─────────────────────────────────────────────────────────────

# Stellar secret key used server-side to sign SEP-10 challenge transactions.
# Must be a valid Stellar secret key (starts with 'S').
# Server-side only — never expose to the client or commit to version control.
STELLAR_SECRET_KEY=

# Public domain of this deployment (without protocol), used in SEP-10 challenges.
# Example: scoutoff.app (production) or localhost:3000 (local dev)
NEXT_PUBLIC_DOMAIN=localhost:3000

# ── Error Monitoring (Sentry) ─────────────────────────────────────────────────

# Sentry DSN (Data Source Name) for client-side error reporting. Leave blank to
# disable Sentry entirely. Obtain from: https://sentry.io — project → Settings → DSN.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry organisation slug (build-time only — set as a CI/host secret).
# Leave blank locally to skip the source-map upload step during `next build`.
SENTRY_ORG=

# Sentry project slug (build-time only — set as a CI/host secret).
SENTRY_PROJECT=

# Sentry auth token for source-map uploads (build-time only).
# Server-side only — never expose to the client or commit to version control.
SENTRY_AUTH_TOKEN=

# Sentry release identifier injected at build time (e.g. a git SHA or semver tag).
# Automatically set in CI; leave blank locally.
SENTRY_RELEASE=

# ── Platform Config ───────────────────────────────────────────────────────────

# XLM fee charged to scouts for pay-to-contact unlocks. Default: 1 (1 XLM).
PLATFORM_CONTACT_FEE_XLM=1

# Stellar public key of the platform admin wallet. Any connected wallet matching
# this address gets access to the /admin panel. Leave blank during development.
# WARNING: if unset in production, any connected wallet is treated as admin.
NEXT_PUBLIC_ADMIN_ADDRESS=

# Filesystem path to the admin audit log's SQLite database (lib/adminAuditStore.ts).
# Leave blank to use the built-in default location.
ADMIN_AUDIT_DB_PATH=

# Filesystem path to the chunked-upload chunk-bytes SQLite database
# (lib/chunkedUploadChunkStore.ts, issue #1175). Must point at a shared
# volume reachable from every instance in a multi-instance deployment — a
# path on per-instance ephemeral disk reintroduces the same "chunk landed
# on one instance, invisible to another" bug this store exists to fix.
# Leave blank to use the built-in default location (fine for local dev).
CHUNKED_UPLOAD_DB_PATH=

# ── Status Page ───────────────────────────────────────────────────────────────

# URL of the public status page (e.g. Instatus, Better Stack, UptimeRobot) that
# monitors the frontend, backend API, and Stellar endpoints. Leave blank to hide
# the live-status link on the /status page.
NEXT_PUBLIC_STATUS_PAGE_URL=

# ── PWA / App URL ─────────────────────────────────────────────────────────────

# Canonical public URL of the app. Used for PWA manifest start_url, Open Graph
# tags, and sitemap generation. Update to your production domain before deploying.
NEXT_PUBLIC_APP_URL=https://scoutoff.app

# ── SEP-10 Challenge Server ───────────────────────────────────────────────────

# Stellar secret key for the SEP-10 server that issues and verifies challenges.
# May be the same key as STELLAR_SECRET_KEY in simple setups.
# Server-side only — never expose to the client or commit to version control.
SEP10_SERVER_KEY=

# Public key (G…) corresponding to SEP10_SERVER_KEY. Exposed to the browser so
# the wallet connect flow can independently verify that a challenge XDR is
# sourced from this account before asking any wallet to sign (SEP-10 client
# validation). Must match Keypair.fromSecret(SEP10_SERVER_KEY).publicKey().
NEXT_PUBLIC_SEP10_SERVER_ACCOUNT=

# Home domain asserted in SEP-10 challenge transactions. Must match the deployed
# origin (e.g. scoutoff.app). For local development use: localhost:3000
SEP10_HOME_DOMAIN=

# Same value as SEP10_HOME_DOMAIN, exposed to the browser for client-side
# challenge validation (manageData name "<domain> auth" / web_auth_domain).
# Keep in sync with SEP10_HOME_DOMAIN.
NEXT_PUBLIC_SEP10_HOME_DOMAIN=

# Comma-separated list of allowed Origin headers for the SEP-10 POST endpoint
# (app/api/auth/sep10/route.ts). REQUIRED before deploying to any non-local
# environment. If unset in production the route fails closed (403). Example:
# SEP10_ALLOWED_ORIGINS=https://scoutoff.app,https://www.scoutoff.app
# Leave blank locally — dev falls back to http://<NEXT_PUBLIC_DOMAIN>.
SEP10_ALLOWED_ORIGINS=

# Secret used to HMAC-sign the `session`/`session_refresh` cookies issued
# after a successful SEP-10 verification (see lib/session.ts). REQUIRED —
# routes that read the session cookie throw if this is unset. Use a long,
# random value (e.g. `openssl rand -base64 48`) and never commit the real
# value. Rotating it immediately invalidates every outstanding session.
SESSION_SECRET=

# 256-bit key sealing the contact vault (see lib/contactVaultCrypto.ts,
# docs/contact-details-encryption.md, issue #1301). REQUIRED for
# /api/contact/* — routes fail closed without it. Hex (64 chars) or base64;
# generate with `openssl rand -hex 32`. Long random value, never commit the
# real one. Rotating it requires re-encrypting contact-vault.db rows (see
# the migration doc) — unlike SESSION_SECRET, rotation does NOT invalidate
# sessions.
CONTACT_VAULT_KEY=

# Where the sealed contact vault lives (optional). Defaults to
# data/contact-vault.db. Holds ONLY AES-GCM ciphertext — mount it on a volume
# that is backed up as ciphertext (a plaintext backup would be a plaintext
# copy of every player's PII). :memory: in tests.
CONTACT_VAULT_DB_PATH=

# ── Session token lifetimes (optional overrides) ──────────────────────────────
# Lifetimes, in seconds, of the tokens lib/session.ts mints (see #1299). Leave
# blank to use the defaults: 1200 (20 min) for the access token, 86400 (1 day)
# for a normal refresh token, 2592000 (30 days) for "remember me".
#
# These are honoured in development/test only — under NODE_ENV=production the
# compiled-in defaults always win, so a stray value here can't mint a
# five-second or ten-year session in a deployment. The E2E suite uses them to
# shrink the access-token lifetime to a few seconds so a token can actually be
# watched lapsing (see e2e/README.md).
ACCESS_TOKEN_TTL_SEC=
DEFAULT_REFRESH_TTL_SEC=
REMEMBER_ME_REFRESH_TTL_SEC=

# ── Runtime (set automatically) ───────────────────────────────────────────────

# Node.js environment. Set automatically by Next.js / your host (development,
# production, test). Do not set this manually in .env.local.
NODE_ENV=

# TCP port the server listens on. Set by your host platform in production.
# Leave blank locally — Next.js defaults to 3000.
PORT=

# Set to a truthy value by CI providers (e.g. GitHub Actions). Read by
# playwright.config.ts / playwright.visual.config.ts to switch to CI-appropriate
# retries, worker count, and reporter. Leave blank locally.
CI=

# Canonical base URL of the frontend (e.g. https://scoutoff.app). Used as a
# convenience single-origin entry folded into SEP10_ALLOWED_ORIGINS and for
# absolute URL generation. Leave blank to derive from NEXT_PUBLIC_DOMAIN.
NEXT_PUBLIC_BASE_URL=

# ── End-to-End Tests (Playwright, e2e/) ───────────────────────────────────────
#
# Only used by the Playwright e2e suite (e2e/, playwright.config.ts) — never
# read by the app itself. Leave blank unless you're running e2e locally
# against a seeded testnet account/contract.

# Port the local dev server binds to for e2e runs. Default: 3100
E2E_PORT=3100

# Stellar secret key for the wallet fixture e2e specs sign transactions with.
# Testnet only — never use a mainnet key here.
E2E_WALLET_SECRET=

# Stellar secret key for the admin wallet used by admin-flow e2e specs
# (e.g. fee withdrawal). Testnet only.
E2E_ADMIN_SECRET=

# Soroban contract ID the e2e suite targets. Specs that need a live contract
# (e.g. wallet-connect-registration) skip themselves when this is unset.
E2E_CONTRACT_ID=

# ── Feature Flags ─────────────────────────────────────────
#
# Set any of these to "1" or "true" to enable the corresponding feature.
# When unset or set to "0" / "false", the feature is disabled.
# These flags are read by lib/featureFlags.ts → isFeatureEnabled().

# Enables the "Download my data" self-service export in the player
# dashboard. Exports profile vitals, progress level, milestone history,
# and IPFS media references as a JSON file.
#   NEXT_PUBLIC_FEATURE_DATA_EXPORT=1
NEXT_PUBLIC_FEATURE_DATA_EXPORT=

# Enables dark mode toggle in the navigation bar. When disabled, the
# app always renders in dark mode (the default theme).
#   NEXT_PUBLIC_FEATURE_DARK_MODE_TOGGLE=1
NEXT_PUBLIC_FEATURE_DARK_MODE_TOGGLE=

# Enables in-app notification system for milestone approvals and
# scout messages. Disabled by default until the feature is complete.
#   NEXT_PUBLIC_FEATURE_IN_APP_NOTIFICATIONS=1
NEXT_PUBLIC_FEATURE_IN_APP_NOTIFICATIONS=

# Enables admin-gated auto-throttling for the two highest-confidence fraud
# heuristics (cross_scout_redeemer_ring, self_redemption). A matching wallet
# is automatically blocked from further redemptions/pay-to-contact until an
# admin explicitly lifts it in FraudFlagsPanel.tsx — never auto-expires.
# Leave disabled until thresholds in lib/fraudDetection.ts have been tuned
# against real traffic; see docs/fraud-detection.md.
#   NEXT_PUBLIC_FEATURE_FRAUD_AUTO_THROTTLE=1
NEXT_PUBLIC_FEATURE_FRAUD_AUTO_THROTTLE=

# Minimum spacing between on-demand fraud-flag evaluations triggered from
# FraudFlagsPanel.tsx (app/api/admin/fraud-flags). Defaults to 30000 (30s)
# when unset. The NEXT_PUBLIC_ variant is read as a fallback so a preview
# deployment can tune it without a server-only var; the server-only value
# wins when both are set.
FRAUD_FLAGS_MIN_INTERVAL_MS=
NEXT_PUBLIC_FRAUD_FLAGS_MIN_INTERVAL_MS=

# Secret token used by Vercel Cron or scheduled runners to authorize cron API endpoints
# (e.g. app/api/cron/fraud-flags). Matches Authorization: Bearer <CRON_SECRET> header.
CRON_SECRET=


# Web Push (issue #558) — public VAPID key matching the backend's private key.
# Leave unset to hide the milestone push-notification opt-in.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
